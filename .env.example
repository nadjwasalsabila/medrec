# Database Configuration (Supabase PostgreSQL)
DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password-here

# Notes:
# 1. Copy this file to .env (without .example)
# 2. Replace DB_USER with your Supabase project reference
# 3. Replace DB_PASSWORD with your actual database password
# 4. Get database credentials from Supabase Project Settings > Database > Connection String
